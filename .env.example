# Nonworking placeholders only. Guest learning needs no environment file.
NEXT_PUBLIC_SUPABASE_URL=https://project.example.invalid
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy Neon/email configuration stays isolated; these values do not enable Supabase.
DATABASE_URL=
REGISTRATION_CODE=
RESEND_API_KEY=
EMAIL_FROM=
SITE_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false
# Optional Azure Speech: leave key/region blank for local recording without upload.
# Create an actual Free (F0) Speech resource; the tier flag cannot change its billing tier.
# Server-only: never prefix these names with NEXT_PUBLIC_, commit real values, or share them in chat.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TIER=F0
# Optional resource endpoint instead of region, e.g. https://resource.cognitiveservices.azure.com/
AZURE_SPEECH_ENDPOINT=
# Setup instructions: AZURE-SETUP-KURDISH.md

